{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // The package entries, which `vp pack` builds into dist/
    "src/index.ts",
    "src/middleware.ts",
    // Loaded by the integration/*.html fixtures with <script type="module">,
    // which Knip doesn't parse
    "integration/utils.js",
    // Type tests, which `vp check` runs with its `@ts-expect-error` comments
    "integration/types.ts",
    // Run with vpx, see integration/wpt/README.md
    "scripts/*.ts",
  ],
  // Vendored, unmodified web-platform-tests
  "ignore": ["integration/wpt/upstream/**"],
  // Loaded by `vp pack` (tsdown) for its `publint` and `attw` checks
  "ignoreDependencies": ["@arethetypeswrong/core", "publint"],
}
